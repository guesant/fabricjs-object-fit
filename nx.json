{
  "$schema": "node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "typedoc": {
      "cache": true
    }
  },
  "defaultBase": "dev",
  "analytics": false,
  "tui": {
    "enabled": false
  }
}