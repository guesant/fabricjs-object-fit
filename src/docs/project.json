{
  "name": "docs",
  "targets": {
    "dev": {
      "command": "pnpm run dev",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "fabricjs-object-fit:typedoc"
      ]
    },
    "build": {
      "command": "pnpm run build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "fabricjs-object-fit:typedoc"
      ],
      "inputs": [
        "{projectRoot}/docs/**/*"
      ],
      "outputs": [
        "{projectRoot}/docs/.vitepress/dist"
      ]
    },
    "preview": {
      "command": "pnpm run preview",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}