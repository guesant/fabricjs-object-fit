{
  "name": "object-fit-canvas",
  "sourceRoot": "object-fit-canvas/src",
  "targets": {
    "build": {
      "command": "pnpm run build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rollup.config.mjs",
        "{projectRoot}/tsconfig.json"
      ],
      "outputs": [
        "{projectRoot}/lib"
      ]
    },
    "dev": {
      "command": "pnpm run dev",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "pnpm run test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/vitest.config.ts"
      ]
    },
    "lint": {
      "command": "pnpm run lint",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*"
      ]
    },
    "lint:fix": {
      "command": "pnpm run lint:fix",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
