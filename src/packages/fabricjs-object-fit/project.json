{
  "name": "fabricjs-object-fit",
  "sourceRoot": "fabricjs-object-fit/src",
  "targets": {
    "build": {
      "command": "pnpm run build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rollup.config.mjs",
        "{projectRoot}/tsconfig.json"
      ],
      "outputs": [
        "{projectRoot}/lib"
      ]
    },
    "dev": {
      "command": "pnpm run dev",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "pnpm run test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/vitest.config.ts"
      ]
    },
    "test:e2e": {
      "command": "pnpm run test:e2e",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/playwright.config.mjs"
      ]
    },
    "lint": {
      "command": "pnpm run lint",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*"
      ]
    },
    "lint:fix": {
      "command": "pnpm run lint:fix",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "typedoc": {
      "command": "pnpm run typedoc",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/typedoc.json"
      ],
      "outputs": [
        "{workspaceRoot}/docs/docs/api"
      ]
    }
  }
}