{
  "name": "fabricjs-object-fit",
  "version": "0.0.0-beta.5",
  "description": "CSS-like 'object-fit' and 'object-position' behavior for FabricJS.",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "browser": "lib/index.umd.js",
  "unpkg": "lib/index.umd.js",
  "repository": "https://github.com/guesant/fabricjs-object-fit.git",
  "homepage": "https://guesant.github.io/fabricjs-object-fit/",
  "author": "Gabriel R. Antunes <gabrielrodantunes@gmail.com>",
  "license": "LGPL-3.0",
  "keywords": [
    "fabricjs",
    "object-fit",
    "cover",
    "contain",
    "fill",
    "object-position"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write .",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "rm -rf lib; rollup --config rollup.config.mjs --watch",
    "build": "rm -rf lib; tsc --noEmit && rollup --config rollup.config.mjs",
    "prepare": "husky install"
  },
  "files": [
    "lib/**/*"
  ],
  "lint-staged": {
    "**/*": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@biomejs/biome": "^2.4.9",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/fabric": "^4.5.6",
    "fabric": "^4.6.0-browser",
    "husky": "^7.0.4",
    "jsdom": "^19.0.0",
    "lint-staged": "^12.1.5",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.4.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "@types/fabric": "^4.5.6"
  }
}
